DATABASE_URL="postgresql://shopsmart_user:shopsmart_dev@localhost:5432/shopsmart?schema=public"
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Grounded assistant (server-only). Copy to backend/.env and never commit the real key.
# Get a key from Google AI Studio. Leave GEMINI_API_KEY empty to use rule-based answers only.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_MS=8000
